// Schéma de la base de la boutique (PostgreSQL dédié, jamais le MySQL de Minecraft).
// Les tables arrivent avec les fonctionnalités : comptes (#17), catalogue (#21), commandes (#23)…

generator client {
  provider = "prisma-client"
  // Client généré dans le code source (ignoré par Git), compilé avec l'API.
  output   = "../src/generated/prisma"
  // Imports en `.js` : l'API est en ESM (module nodenext).
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Comptes ────────────────────────────────────────────────────

model User {
  id String @id @default(uuid()) @db.Uuid
  /// Toujours en minuscules (normalisé par l'API).
  email String @unique
  /// Renseigné à la confirmation de l'adresse. Sans lui, aucune connexion possible.
  emailVerifiedAt DateTime? @map("email_verified_at")
  /// argon2id. Vide pour un compte qui n'utilise que OAuth (#18).
  passwordHash String? @map("password_hash")
  failedLogins Int @default(0) @map("failed_logins")
  lastFailedLoginAt DateTime? @map("last_failed_login_at")
  lockedUntil DateTime? @map("locked_until")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions Session[]
  emailTokens EmailToken[]
  licenses License[]

  @@map("users")
}

/// Session ouverte par une connexion. Le jeton du cookie n'est jamais stocké : seulement son empreinte.
model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash")
  /// Jeton anti-CSRF exigé (en-tête X-CSRF-Token) sur les requêtes qui modifient des données.
  csrfToken String @map("csrf_token")
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId])
  @@map("sessions")
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD

  @@map("email_token_type")
}

/// Lien envoyé par e-mail : à usage unique, valable peu de temps. Seule l'empreinte du jeton est stockée.
model EmailToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type EmailTokenType
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, type])
  @@map("email_tokens")
}

/// Rattache au compte une clé de licence qui existe déjà sur le serveur de licences (anciens clients,
/// clés créées à la main). Ne défait pas le lien à un achat : `order_id` s'ajoute avec les commandes (#23/#24).
model License {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Clé telle que sur le serveur de licences. Une seule ligne par clé : jamais rattachée à deux comptes.
  licenseKey String @unique @map("license_key")
  claimedAt DateTime @default(now()) @map("claimed_at")

  @@index([userId])
  @@map("licenses")
}

// ─── Catalogue ──────────────────────────────────────────────────

enum ProductDistribution {
  /// Un seul jar : la clé de licence décide de l'édition (Bedwars, Pass).
  SINGLE_JAR
  /// Deux jars, `free` et `premium` (Tag, Crate).
  FREE_PREMIUM_JARS

  @@map("product_distribution")
}

/// Un plugin vendu. Ajouter un plugin = ajouter une ligne (migration ou, plus tard, back-office).
model Product {
  id String @id @default(uuid()) @db.Uuid
  /// Identifiant dans les adresses du site (`/plugins/tag`).
  slug String @unique
  name String
  description String
  /// Produit correspondant sur le serveur de licences (`tagcustom` est l'ancien nom de Tag).
  licenseProduct String @unique @map("license_product")
  distribution ProductDistribution
  /// `{ platform, java, dependencies: [{ name, required, note }] }` : voir `ProductRequirements` dans @fondamental/shared.
  requirements Json
  /// Prix en centimes. Vide tant que le prix n'est pas fixé : le produit n'est alors pas achetable.
  priceCents Int? @map("price_cents")
  currency String @default("eur")
  /// Prix Stripe (`price_…`). Vide tant que le produit n'est pas créé chez Stripe.
  stripePriceId String? @map("stripe_price_id")
  /// Nombre d'installations (serveurs) par licence. À confirmer (#21) : chaque serveur d'un réseau compte pour une.
  maxActivations Int @default(5) @map("max_activations")
  active Boolean @default(true)
  sortOrder Int @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  releases Release[]

  @@map("products")
}

// ─── Fichiers ───────────────────────────────────────────────────

/// Versions de Minecraft proposées dans le sélecteur du site.
model MinecraftVersion {
  id String @id @default(uuid()) @db.Uuid
  /// `1.21.4`
  version String @unique
  /// Plus grand = plus récent : sert à trier du plus récent au plus ancien.
  sortOrder Int @map("sort_order")

  files ReleaseFile[]

  @@map("minecraft_versions")
}

enum ReleaseChannel {
  RELEASE
  BETA

  @@map("release_channel")
}

/// Une version d'un plugin (ex. FondamentalTag 2.2.0).
model Release {
  id String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Texte libre : toutes les versions ne sont pas de la forme 1.2.3 (`1.0-SNAPSHOT`).
  version String
  channel ReleaseChannel @default(RELEASE)
  changelog String @default("")
  releasedAt DateTime @default(now()) @map("released_at")

  files ReleaseFile[]

  @@unique([productId, version])
  @@map("releases")
}

enum ReleaseEdition {
  /// Un seul jar : la clé de licence décide de l'édition.
  UNIVERSAL
  FREE
  PREMIUM

  @@map("release_edition")
}

enum ReleasePlatform {
  PAPER

  @@map("release_platform")
}

/// Un jar téléchargeable. Les téléchargements sont publics : la licence, pas le fichier, débloque le premium.
model ReleaseFile {
  id String @id @default(uuid()) @db.Uuid
  releaseId String @map("release_id") @db.Uuid
  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  edition ReleaseEdition
  platform ReleasePlatform @default(PAPER)
  /// Nom proposé au téléchargement (`fondamentaltag-premium-2.2.0-obf.jar`).
  fileName String @map("file_name")
  sizeBytes Int @map("size_bytes")
  /// Empreinte SHA-256 en hexadécimal, affichée pour que le client vérifie son fichier.
  sha256 String
  /// Chemin relatif au dossier des fichiers (`RELEASES_DIR`), jamais absolu.
  storagePath String @map("storage_path")
  downloadCount Int @default(0) @map("download_count")
  createdAt DateTime @default(now()) @map("created_at")
  minecraftVersions MinecraftVersion[]

  @@unique([releaseId, fileName])
  @@index([releaseId])
  @@map("release_files")
}
