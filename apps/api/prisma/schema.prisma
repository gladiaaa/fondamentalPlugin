// Schéma de la base de la boutique (PostgreSQL dédié, jamais le MySQL de Minecraft).
// Les tables arrivent avec les fonctionnalités : comptes (#17), catalogue (#21), commandes (#23)…

generator client {
  provider = "prisma-client"
  // Client généré dans le code source (ignoré par Git), compilé avec l'API.
  output   = "../src/generated/prisma"
  // Imports en `.js` : l'API est en ESM (module nodenext).
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Comptes ────────────────────────────────────────────────────

/// Langue des e-mails transactionnels, détectée à l'inscription (Accept-Language), jamais redemandée ensuite.
enum Locale {
  FR
  EN

  @@map("locale")
}

/// Aucune inscription publique ne donne `ADMIN` : attribué à la main en base (voir #32).
enum Role {
  CUSTOMER
  ADMIN

  @@map("role")
}

model User {
  id String @id @default(uuid()) @db.Uuid
  /// Toujours en minuscules (normalisé par l'API).
  email String @unique
  locale Locale @default(FR)
  role Role @default(CUSTOMER)
  /// Renseigné à la confirmation de l'adresse. Sans lui, aucune connexion possible.
  emailVerifiedAt DateTime? @map("email_verified_at")
  /// argon2id. Vide pour un compte qui n'utilise que OAuth (#18).
  passwordHash String? @map("password_hash")
  failedLogins Int @default(0) @map("failed_logins")
  lastFailedLoginAt DateTime? @map("last_failed_login_at")
  lockedUntil DateTime? @map("locked_until")
  /// Secret TOTP (base32). En clair : l'algorithme en a besoin pour vérifier un code, comme partout
  /// ailleurs (Google Authenticator, etc.) ; protégé par les mêmes accès que le reste de la base.
  totpSecret String? @map("totp_secret")
  /// Posé au premier code validé après `/admin/2fa/setup`. Sans lui, aucune route admin n'est accessible.
  totpEnabledAt DateTime? @map("totp_enabled_at")
  /// Posé par un admin (#105) : connexion refusée et sessions fermées tant qu'il est renseigné.
  blockedAt DateTime? @map("blocked_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions Session[]
  emailTokens EmailToken[]
  licenses License[]
  orders Order[]
  savedConfigs SavedConfig[]
  adminActions AdminAction[]

  @@map("users")
}

/// Session ouverte par une connexion. Le jeton du cookie n'est jamais stocké : seulement son empreinte.
model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash")
  /// Jeton anti-CSRF exigé (en-tête X-CSRF-Token) sur les requêtes qui modifient des données.
  csrfToken String @map("csrf_token")
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  /// Posé par `/admin/2fa/verify` : la 2FA est vérifiée **par session**, pas une fois pour toutes (#32).
  twoFactorVerifiedAt DateTime? @map("two_factor_verified_at")

  @@index([userId])
  @@map("sessions")
}

/// Journal des actions sensibles du back-office (remboursement, révocation, changement de prix…), #32.
model AdminAction {
  id String @id @default(uuid()) @db.Uuid
  adminId String @map("admin_id") @db.Uuid
  /// Ne disparaît jamais avec le compte : c'est le journal, pas une donnée de l'admin.
  admin User @relation(fields: [adminId], references: [id], onDelete: Restrict)
  /// `order.refund`, `license.revoke`, `license.recreate`, `order.resend_email`, `product.update`…
  action String
  targetType String @map("target_type")
  targetId String @map("target_id")
  /// Détails de l'action (ex. anciens/nouveaux prix). Jamais de secret dedans.
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([targetType, targetId])
  @@map("admin_actions")
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD

  @@map("email_token_type")
}

/// Lien envoyé par e-mail : à usage unique, valable peu de temps. Seule l'empreinte du jeton est stockée.
model EmailToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type EmailTokenType
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, type])
  @@map("email_tokens")
}

/// Rattache au compte une clé de licence qui existe déjà sur le serveur de licences (anciens clients,
/// clés créées à la main, ou clé créée par un achat : voir `orderId`).
model License {
  id String @id @default(uuid()) @db.Uuid
  /// `null` : compte supprimé. La ligne reste, pour qu'un remboursement ultérieur révoque encore la clé.
  userId String? @map("user_id") @db.Uuid
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Clé telle que sur le serveur de licences. Une seule ligne par clé : jamais rattachée à deux comptes.
  licenseKey String @unique @map("license_key")
  /// Vide pour une clé rattachée à la main (#45). Présent pour une clé créée par un achat (#24).
  orderId String? @unique @map("order_id") @db.Uuid
  order Order? @relation(fields: [orderId], references: [id])
  /// Plugin de la clé (#30) : connu à l'achat, lu sur le serveur de licences au rattachement. Vide pour
  /// une clé rattachée avant cette colonne, complété à la première demande du générateur.
  productId String? @map("product_id") @db.Uuid
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  claimedAt DateTime @default(now()) @map("claimed_at")

  @@index([userId])
  @@index([productId])
  @@map("licenses")
}

// ─── Catalogue ──────────────────────────────────────────────────

enum ProductDistribution {
  /// Un seul jar : la clé de licence décide de l'édition (Bedwars, Pass).
  SINGLE_JAR
  /// Deux jars, `free` et `premium` (Tag, Crate).
  FREE_PREMIUM_JARS

  @@map("product_distribution")
}

/// Un plugin vendu. Ajouter un plugin = ajouter une ligne (migration ou, plus tard, back-office).
model Product {
  id String @id @default(uuid()) @db.Uuid
  /// Identifiant dans les adresses du site (`/plugins/tag`).
  slug String @unique
  name String
  description String
  /// Produit correspondant sur le serveur de licences (`tagcustom` est l'ancien nom de Tag).
  licenseProduct String @unique @map("license_product")
  distribution ProductDistribution
  /// `{ platform, java, dependencies: [{ name, required, note }] }` : voir `ProductRequirements` dans @fondamental/shared.
  requirements Json
  /// Prix en centimes. Vide tant que le prix n'est pas fixé : le produit n'est alors pas achetable.
  priceCents Int? @map("price_cents")
  currency String @default("eur")
  /// Prix Stripe (`price_…`). Vide tant que le produit n'est pas créé chez Stripe.
  stripePriceId String? @map("stripe_price_id")
  /// Nombre d'installations (serveurs) par licence. À confirmer (#21) : chaque serveur d'un réseau compte pour une.
  maxActivations Int @default(5) @map("max_activations")
  active Boolean @default(true)
  sortOrder Int @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  releases Release[]
  orders Order[]
  licenses License[]

  @@map("products")
}

// ─── Commandes ──────────────────────────────────────────────────

/// `PENDING` → `PAID` (webhook reçu) → `LICENSED` (clé créée) ; ou `REFUNDED` depuis `PAID`/`LICENSED`.
enum OrderStatus {
  PENDING
  PAID
  LICENSED
  REFUNDED

  @@map("order_status")
}

/// Un achat Stripe Checkout. `stripeCheckoutSessionId` est unique : un paiement ne peut
/// jamais donner deux licences, même si Stripe rejoue son webhook (#24).
model Order {
  id String @id @default(uuid()) @db.Uuid
  /// `null` : compte supprimé (RGPD). La commande reste, sans lien avec personne (obligation comptable :
  /// les factures sont chez Stripe, conservées 10 ans).
  userId String? @map("user_id") @db.Uuid
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId String @map("product_id") @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  stripeCheckoutSessionId String @unique @map("stripe_checkout_session_id")
  /// Vide tant que le paiement n'est pas confirmé (`checkout.session.completed`).
  stripePaymentIntentId String? @unique @map("stripe_payment_intent_id")
  /// Copie du prix au moment de l'achat : ne bouge pas si le prix du produit change ensuite.
  amountCents Int @map("amount_cents")
  currency String
  status OrderStatus @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  license License?

  @@index([userId])
  @@map("orders")
}

// ─── Fichiers ───────────────────────────────────────────────────

/// Versions de Minecraft proposées dans le sélecteur du site.
model MinecraftVersion {
  id String @id @default(uuid()) @db.Uuid
  /// `1.21.4`
  version String @unique
  /// Plus grand = plus récent : sert à trier du plus récent au plus ancien.
  sortOrder Int @map("sort_order")

  files ReleaseFile[]

  @@map("minecraft_versions")
}

enum ReleaseChannel {
  RELEASE
  BETA

  @@map("release_channel")
}

/// Une version d'un plugin (ex. FondamentalTag 2.2.0).
model Release {
  id String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Texte libre : toutes les versions ne sont pas de la forme 1.2.3 (`1.0-SNAPSHOT`).
  version String
  channel ReleaseChannel @default(RELEASE)
  changelog String @default("")
  releasedAt DateTime @default(now()) @map("released_at")
  /// Posé par un admin (#105) : la version disparaît de la page publique et ne se télécharge plus.
  hiddenAt DateTime? @map("hidden_at")

  files ReleaseFile[]

  @@unique([productId, version])
  @@map("releases")
}

enum ReleaseEdition {
  /// Un seul jar : la clé de licence décide de l'édition.
  UNIVERSAL
  FREE
  PREMIUM

  @@map("release_edition")
}

enum ReleasePlatform {
  PAPER

  @@map("release_platform")
}

/// Un jar téléchargeable. Les téléchargements sont publics : la licence, pas le fichier, débloque le premium.
model ReleaseFile {
  id String @id @default(uuid()) @db.Uuid
  releaseId String @map("release_id") @db.Uuid
  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  edition ReleaseEdition
  platform ReleasePlatform @default(PAPER)
  /// Nom proposé au téléchargement (`fondamentaltag-premium-2.2.0-obf.jar`).
  fileName String @map("file_name")
  sizeBytes Int @map("size_bytes")
  /// Empreinte SHA-256 en hexadécimal, affichée pour que le client vérifie son fichier.
  sha256 String
  /// Chemin relatif au dossier des fichiers (`RELEASES_DIR`), jamais absolu.
  storagePath String @map("storage_path")
  downloadCount Int @default(0) @map("download_count")
  createdAt DateTime @default(now()) @map("created_at")
  minecraftVersions MinecraftVersion[]

  @@unique([releaseId, fileName])
  @@index([releaseId])
  @@map("release_files")
}

// ─── Générateur de configuration (#30) ──────────────────────────

/// Une configuration enregistrée par un acheteur : les valeurs du formulaire d'un fichier d'un plugin.
model SavedConfig {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  /// Plugin (`Product.slug`), version et fichier : voir `configs/config-registry.ts`.
  productSlug String @map("product_slug")
  version String
  file String
  /// Valeurs du formulaire, dans la forme du YAML.
  values Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("saved_configs")
}
