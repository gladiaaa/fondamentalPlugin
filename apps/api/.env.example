# API : copier en apps/api/.env pour le développement local (jamais commité).

# local (poste de dev), dev ou prod (VPS)
APP_ENV=local
PORT=4000
LOG_LEVEL=info

# Base PostgreSQL de développement : `docker compose -f compose.dev.yml up -d` à la racine.
# Uniquement la base dédiée de la boutique, jamais le MySQL de Minecraft.
DATABASE_URL=postgresql://fondamental:fondamental@localhost:5432/fondamental
