# API : copier en apps/api/.env pour le développement local (jamais commité).

# local (poste de dev), dev ou prod (VPS)
APP_ENV=local
PORT=4000
LOG_LEVEL=info

# Base PostgreSQL de développement : `docker compose -f compose.dev.yml up -d` à la racine.
# Uniquement la base dédiée de la boutique, jamais le MySQL de Minecraft.
DATABASE_URL=postgresql://fondamental:fondamental@localhost:5432/fondamental

# Adresse publique du site : sert aux liens des e-mails et aux origines autorisées (anti-CSRF).
# Facultative : déduite de APP_ENV (local → http://localhost:3000, dev → https://dev.fondamentalplugin.fr,
# prod → https://fondamentalplugin.fr).
# SITE_URL=

# E-mails (Resend). En local, sans clé, les e-mails sont affichés dans les logs de l'API (liens compris) :
# c'est là qu'on récupère le lien de confirmation. Sur dev et prod, sans clé, l'inscription, le renvoi du
# lien de confirmation et « mot de passe oublié » répondent 503.
# RESEND_API_KEY=
# MAIL_FROM="Fondamental <noreply@fondamentalplugin.fr>"

# Jars publiés (téléchargements) : un dossier par plugin et par version. Relatif au dossier de lancement, ou absolu.
# RELEASES_DIR=./data/releases
# Si nginx sert les fichiers (location `internal` sur ce dossier), son préfixe : l'API répond alors par X-Accel-Redirect.
# DOWNLOADS_ACCEL_PREFIX=/protected-releases

# Publication d'une version par la CI des plugins (docs/release-plugin.md). Sans jeton, la publication est refusée.
# Au moins 32 caractères : `openssl rand -base64 32`. Taille maximale d'un jar : 50 Mo par défaut.
# RELEASES_TOKEN=
# RELEASES_MAX_UPLOAD_MB=50

# Serveur de licences Fondamental (API admin). Sans les deux, les fonctions qui en dépendent
# (rattacher une clé existante…) répondent 503.
# LICENSE_SERVER_URL=https://licence.fondamentalplugin.fr
# LICENSE_ADMIN_TOKEN=

# Achat (Stripe, #23/#24). Clé secrète et secret du webhook, propres à chaque environnement
# (test en local/dev, live en prod). Sans elles, l'achat répond 503.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Formulaire de contact (#81). Destinataire du message envoyé par /api/support.
# SUPPORT_EMAIL=support@fondamentalplugin.fr

# Suivi des erreurs (Sentry, #33). Sans elle, l'API tourne normalement, simplement sans remontée d'erreurs.
# SENTRY_DSN=
