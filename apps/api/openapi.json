  "info": {
    "title": "API Fondamental Plugin",
    "description": "API de la boutique Fondamental Plugin, servie sous `/api` sur le même domaine que le site.\n\n**À respecter dans tous les appels**\n- Appels faits depuis le navigateur, sur le même domaine, avec les cookies (`credentials: 'same-origin'`).\n- Toute requête qui modifie des données (POST, PUT, PATCH, DELETE) doit venir de l'origine du site (en-tête `Origin`, posé par le navigateur).\n- Si la route exige une session, ces requêtes doivent aussi porter l'en-tête `X-CSRF-Token` (valeur `csrfToken` reçue à la connexion ou par `GET /auth/me`).\n- Les champs inconnus dans un corps JSON sont refusés (400).\n- Les erreurs ont toutes la forme `ApiErrorResponse` ; lire `message` et, s'il existe, `code`.\n\nGuide complet : `docs/api-front.md`.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-session",
        "description": "Cookie de session (`session` en local), posé par `POST /auth/login`. `HttpOnly` : le JavaScript ne le lit pas."
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Valeur de `csrfToken`, exigée sur les requêtes qui modifient des données quand la route demande une session."
      }
    },
    "schemas": {
      "HealthApiResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "version": {
            "type": "string",
            "example": "dev-4a9b293",
            "description": "Version en ligne : `<branche>-<commit court>`."
          },
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "required": [
          "ok",
          "version",
          "database"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "description": "Refusé (`PASSWORD_COMPROMISED`) s’il figure dans des fuites de données connues."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "MessageApiResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "description": "Texte affichable. Un tableau (un texte par champ invalide) pour les erreurs de validation."
          },
          "error": {
            "type": "string",
            "example": "Bad Request"
          },
          "code": {
            "type": "string",
            "enum": [
              "EMAIL_NOT_VERIFIED",
              "PASSWORD_COMPROMISED",
              "INVALID_LINK",
              "CURRENT_PASSWORD_INVALID",
              "NO_PASSWORD",
              "SAME_PASSWORD"
            ],
            "description": "Présent pour les erreurs que le site doit distinguer."
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      },
      "TokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200,
            "description": "Jeton lu dans l’adresse de la page ouverte depuis le lien de l’e-mail."
          }
        },
        "required": [
          "token"
        ]
      },
      "EmailVerifiedApiResponse": {
        "type": "object",
        "properties": {
          "emailVerified": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "emailVerified"
        ]
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "ada@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ada@example.com"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "createdAt"
        ]
      },
      "SessionApiResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUserResponse"
          },
          "csrfToken": {
            "type": "string",
            "description": "À renvoyer dans l’en-tête `X-CSRF-Token` de chaque requête qui modifie des données tant qu’on est connecté. À garder en mémoire, jamais dans `localStorage` ni dans une URL."
          }
        },
        "required": [
          "user",
          "csrfToken"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200,
            "description": "Jeton lu dans l’adresse de la page ouverte depuis le lien de l’e-mail."
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "description": "Refusé (`PASSWORD_COMPROMISED`) s’il figure dans des fuites de données connues."
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 128
          },
          "newPassword": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "description": "Refusé (`PASSWORD_COMPROMISED`) s’il figure dans des fuites de données connues."
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      }
    }
  }
}
