            }
          }
        },
        "summary": "Versions de Minecraft disponibles",
        "tags": [
          "fichiers"
        ]
      }
    },
    "/api/products/{slug}/files": {
      "get": {
        "description": "Du plus récent au plus ancien, chacun avec sa version, son édition, son changelog, sa taille et son SHA-256. Un plugin à deux jars (Tag, Crate) en renvoie deux par version. Public.",
        "operationId": "ReleasesController_files",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "schema": {
              "example": "tag",
              "type": "string"
            }
          },
          {
            "name": "minecraft",
            "required": false,
            "in": "query",
            "description": "Ne garde que les fichiers compatibles avec cette version de Minecraft.",
            "schema": {
              "example": "1.21.4",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReleaseFileApiResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Requête invalide (validation, lien expiré, mot de passe refusé…). Voir `code`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Ressource introuvable (ou pas accessible à ce compte).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Trop de requêtes : réessayer plus tard.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Fichiers d’un plugin",
        "tags": [
          "fichiers"
        ]
      }
    },
    "/api/downloads/{fileId}": {
      "get": {
        "description": "Public. Répond par le fichier (`Content-Disposition: attachment`). En ligne, nginx peut servir le fichier (`X-Accel-Redirect`) : le site n’a rien à changer.",
        "operationId": "DownloadsController_download",
        "parameters": [
          {
            "name": "fileId",
            "required": true,
            "in": "path",
            "description": "Le champ `id` d’un fichier de `GET /products/:slug/files`.",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Le fichier `.jar`.",
            "content": {
              "application/java-archive": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Ressource introuvable (ou pas accessible à ce compte).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Trop de requêtes : réessayer plus tard.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Télécharger un jar",
        "tags": [
          "fichiers"
        ]
      }
    }
  },
  "info": {
    "title": "API Fondamental Plugin",
    "description": "API de la boutique Fondamental Plugin, servie sous `/api` sur le même domaine que le site.\n\n**À respecter dans tous les appels**\n- Appels faits depuis le navigateur, sur le même domaine, avec les cookies (`credentials: 'same-origin'`).\n- Toute requête qui modifie des données (POST, PUT, PATCH, DELETE) doit venir de l'origine du site (en-tête `Origin`, posé par le navigateur).\n- Si la route exige une session, ces requêtes doivent aussi porter l'en-tête `X-CSRF-Token` (valeur `csrfToken` reçue à la connexion ou par `GET /auth/me`).\n- Les champs inconnus dans un corps JSON sont refusés (400).\n- Les erreurs ont toutes la forme `ApiErrorResponse` ; lire `message` et, s'il existe, `code`.\n\nGuide complet : `docs/api-front.md`.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-session",
        "description": "Cookie de session (`session` en local), posé par `POST /auth/login`. `HttpOnly` : le JavaScript ne le lit pas."
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Valeur de `csrfToken`, exigée sur les requêtes qui modifient des données quand la route demande une session."
      }
    },
    "schemas": {
      "HealthApiResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "version": {
            "type": "string",
            "example": "dev-4a9b293",
            "description": "Version en ligne : `<branche>-<commit court>`."
          },
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "required": [
          "ok",
          "version",
          "database"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "description": "Refusé (`PASSWORD_COMPROMISED`) s’il figure dans des fuites de données connues."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "MessageApiResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "description": "Texte affichable. Un tableau (un texte par champ invalide) pour les erreurs de validation."
          },
          "error": {
            "type": "string",
            "example": "Bad Request"
          },
          "code": {
            "type": "string",
            "enum": [
              "EMAIL_NOT_VERIFIED",
              "PASSWORD_COMPROMISED",
              "INVALID_LINK",
              "CURRENT_PASSWORD_INVALID",
              "NO_PASSWORD",
              "SAME_PASSWORD"
            ],
            "description": "Présent pour les erreurs que le site doit distinguer."
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      },
      "TokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200,
            "description": "Jeton lu dans l’adresse de la page ouverte depuis le lien de l’e-mail."
          }
        },
        "required": [
          "token"
        ]
      },
      "EmailVerifiedApiResponse": {
        "type": "object",
        "properties": {
          "emailVerified": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "emailVerified"
        ]
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "ada@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ada@example.com"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "createdAt"
        ]
      },
      "SessionApiResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUserResponse"
          },
          "csrfToken": {
            "type": "string",
            "description": "À renvoyer dans l’en-tête `X-CSRF-Token` de chaque requête qui modifie des données tant qu’on est connecté. À garder en mémoire, jamais dans `localStorage` ni dans une URL."
          }
        },
        "required": [
          "user",
          "csrfToken"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200,
            "description": "Jeton lu dans l’adresse de la page ouverte depuis le lien de l’e-mail."
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "description": "Refusé (`PASSWORD_COMPROMISED`) s’il figure dans des fuites de données connues."
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 128
          },
          "newPassword": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128,
            "description": "Refusé (`PASSWORD_COMPROMISED`) s’il figure dans des fuites de données connues."
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "AccountExportAccountResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "emailVerifiedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "hasPassword": {
            "type": "boolean",
            "description": "`false` pour un compte qui n’utilise que la connexion par un service tiers."
          }
        },
        "required": [
          "id",
          "email",
          "createdAt",
          "emailVerifiedAt",
          "hasPassword"
        ]
      },
      "AccountExportSessionResponse": {
        "type": "object",
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "current": {
            "type": "boolean",
            "description": "`true` pour la session qui a demandé l’export."
          }
        },
        "required": [
          "createdAt",
          "expiresAt",
          "current"
        ]
      },
      "AccountExportApiResponse": {
        "type": "object",
        "properties": {
          "exportedAt": {
            "type": "string",
            "format": "date-time"
          },
          "account": {
            "$ref": "#/components/schemas/AccountExportAccountResponse"
          },
          "sessions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountExportSessionResponse"
            }
          }
        },
        "required": [
          "exportedAt",
          "account",
          "sessions"
        ]
      },
      "DeleteAccountDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 128,
            "description": "Le mot de passe du compte, redemandé par sécurité."
          }
        },
        "required": [
          "password"
        ]
      },
      "ProductDependencyApiResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "FastAsyncWorldEdit"
          },
          "required": {
            "type": "boolean",
            "description": "`true` : le plugin ne démarre pas sans lui."
          },
          "note": {
            "type": "string",
            "description": "Pourquoi il est utile (texte affichable)."
          }
        },
        "required": [
          "name",
          "required",
          "note"
        ]
      },
      "ProductRequirementsApiResponse": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "example": "Paper 1.21.4+"
          },
          "java": {
            "type": "number",
            "example": 21,
            "description": "Version minimale de Java."
          },
          "dependencies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductDependencyApiResponse"
            }
          }
        },
        "required": [
          "platform",
          "java",
          "dependencies"
        ]
      },
      "ProductPriceApiResponse": {
        "type": "object",
        "properties": {
          "amountCents": {
            "type": "number",
            "example": 1999,
            "description": "En centimes (1999 = 19,99)."
          },
          "currency": {
            "type": "string",
            "example": "eur",
            "description": "Code ISO 4217 en minuscules."
          }
        },
        "required": [
          "amountCents",
          "currency"
        ]
      },
      "ProductApiResponse": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "tag",
            "description": "Identifiant dans les adresses du site."
          },
          "name": {
            "type": "string",
            "example": "FondamentalTag"
          },
          "description": {
            "type": "string"
          },
          "distribution": {
            "type": "string",
            "enum": [
              "SINGLE_JAR",
              "FREE_PREMIUM_JARS"
            ],
            "description": "`SINGLE_JAR` : un seul jar, la clé de licence décide de l’édition. `FREE_PREMIUM_JARS` : deux jars, `free` et `premium`."
          },
          "requirements": {
            "$ref": "#/components/schemas/ProductRequirementsApiResponse"
          },
          "price": {
            "nullable": true,
            "description": "`null` tant que le prix n’est pas fixé.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ProductPriceApiResponse"
              }
            ]
          },
          "purchasable": {
            "type": "boolean",
            "description": "`false` : ne pas proposer l’achat (prix ou paiement pas encore configurés)."
          }
        },
        "required": [
          "slug",
          "name",
          "description",
          "distribution",
          "requirements",
          "price",
          "purchasable"
        ]
      },
      "ReleaseInfoApiResponse": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "example": "2.2.0",
            "description": "Texte libre : ne pas la traiter comme un numéro."
          },
          "channel": {
            "type": "string",
            "enum": [
              "RELEASE",
              "BETA"
            ]
          },
          "changelog": {
            "type": "string",
            "description": "Notes de version, en texte brut (peut être vide)."
          },
          "releasedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "version",
          "channel",
          "changelog",
          "releasedAt"
        ]
      },
      "ReleaseFileApiResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "edition": {
            "type": "string",
            "enum": [
              "UNIVERSAL",
              "FREE",
              "PREMIUM"
            ],
            "description": "`UNIVERSAL` : jar unique, la clé de licence décide de l’édition. `FREE` / `PREMIUM` : les deux jars de Tag et Crate."
          },
          "platform": {
            "type": "string",
            "enum": [
              "PAPER"
            ]
          },
          "fileName": {
            "type": "string",
            "example": "fondamentaltag-free-2.2.0-obf.jar"
          },
          "sizeBytes": {
            "type": "number",
            "description": "Taille en octets."
          },
          "sha256": {
            "type": "string",
            "description": "SHA-256 en hexadécimal, à afficher pour la vérification du fichier."
          },
          "minecraftVersions": {
            "example": [
              "1.21.11",
              "1.21.4"
            ],
            "description": "De la plus récente à la plus ancienne.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "downloadCount": {
            "type": "number"
          },
          "downloadUrl": {
            "type": "string",
            "example": "/api/downloads/8f1b3c1e-0000-4000-8000-000000000001"
          },
          "release": {
            "$ref": "#/components/schemas/ReleaseInfoApiResponse"
          }
        },
        "required": [
          "id",
          "edition",
          "platform",
          "fileName",
          "sizeBytes",
          "sha256",
          "minecraftVersions",
          "downloadCount",
          "downloadUrl",
          "release"
        ]
      }
    }
  }
}
