    "/api/auth/register": {
      "post": {
        "description": "Envoie un e-mail de confirmation. La réponse est **identique** que l’adresse soit déjà inscrite ou non : ne jamais dire « adresse déjà utilisée ». La langue des e-mails du compte est choisie une fois pour toutes ici, d’après `Accept-Language` (français par défaut).",
        "operationId": "AuthController_register",
        "parameters": [
          {
            "name": "accept-language",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Requête invalide (validation, lien expiré, mot de passe refusé…). Voir `code`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Origine refusée, jeton CSRF absent ou faux, ou adresse non confirmée (`EMAIL_NOT_VERIFIED`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Trop de requêtes : réessayer plus tard.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service momentanément indisponible (envoi d’e-mails, base de données).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Créer un compte",
        "tags": [
          "auth"
        ]
      }
    },
