# URL publique du site (sans / final) : utilisée pour les retours Stripe
SITE_URL=http://localhost:3000

# Stripe (clés de TEST en local : sk_test_... / whsec_... de `stripe listen`)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Serveur de licences Fondamental (API admin)
LICENSE_SERVER_URL=
LICENSE_ADMIN_TOKEN=

# E-mails (optionnel : sans clé, la licence est seulement affichée à l'écran)
RESEND_API_KEY=
MAIL_FROM="Fondamental <licences@exemple.fr>"
